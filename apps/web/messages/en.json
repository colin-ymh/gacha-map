  "terms": {
    "title": "Terms of Service",
    "back": "Back",
    "s1Title": "Article 1 (Purpose)",
    "s1p1": "These terms govern the conditions and procedures for using the services provided by GachaMap (hereinafter \"Service\"), as well as the rights, obligations, and responsibilities of users and the Service.",
    "s2Title": "Article 2 (Definitions)",
    "s2p1": "\"User\" refers to both members and non-members who access the Service and receive services in accordance with these terms.",
    "s2p2": "\"Member\" refers to a person who has registered by providing personal information to the Service and can continuously receive information and use the Service.",
    "s3Title": "Article 3 (Effect and Amendment of Terms)",
    "s3p1": "These terms apply to all users who intend to use the Service.",
    "s3p2": "The Service may amend these terms within the scope permitted by applicable laws when necessary. Amended terms will be notified to users via in-service announcements.",
    "s4Title": "Article 4 (Provision and Changes to Services)",
    "s4p1": "The Service provides gacha shop location information, shop report submissions, and wishlist management.",
    "s4p2": "The Service may modify all or part of the services provided when there is a significant reason.",
    "s5Title": "Article 5 (User Obligations)",
    "s5p1": "Users must not engage in the following acts.",
    "s5p2": "Registering false information, stealing others' information, interfering with service operations, infringing on others' rights including copyrights, or any other illegal or improper conduct.",
    "s6Title": "Article 6 (Restrictions on Service Use)",
    "s6p1": "The Service may restrict a user's access if the user violates obligations under these terms or interferes with normal service operations.",
    "s7Title": "Article 7 (Disclaimer)",
    "s7p1": "The Service is exempt from liability for service disruptions caused by natural disasters, war, or other force majeure events.",
    "s7p2": "Report information within the Service is based on content provided by users, and the Service does not guarantee the accuracy of such information.",
    "s8Title": "Article 8 (Contact)",
    "s8p1": "For inquiries related to service use, please contact us at gachamap1120@gmail.com.",
    "effectiveDate": "Effective date: April 17, 2026"
  },
  "privacy": {
    "title": "Privacy Policy",
    "back": "Back",
    "s1Title": "1. Personal Information We Collect",
    "s1p1": "The service collects the following personal information during account registration and use.",
    "s1p2": "When signing in via social login (Google, Kakao, Naver): name, email address, profile image (optional).",
    "s2Title": "2. Purpose of Collecting and Using Personal Information",
    "s2p1": "The service uses collected personal information for the following purposes.",
    "s2p2": "Member identification and service provision, management of wishlist and report history, statistical analysis for service improvement.",
    "s3Title": "3. Retention and Use Period of Personal Information",
    "s3p1": "Personal information is destroyed without delay upon account deletion or once the purpose of collection and use has been achieved.",
    "s3p2": "However, information may be retained for the required period if preservation is necessary under applicable laws.",
    "s4Title": "4. Disclosure of Personal Information to Third Parties",
    "s4p1": "The service does not disclose users' personal information to third parties in principle. Exceptions apply when required by law or requested by investigative authorities.",
    "s5Title": "5. Delegation of Personal Information Processing",
    "s5p1": "The service delegates personal information processing to Supabase (database and authentication services) for smooth operations. Updates to the delegation scope and processors will be announced upon changes to this policy.",
    "s6Title": "6. User Rights",
    "s6p1": "Users may access, modify, or request deletion of their personal information at any time through account deletion.",
    "s7Title": "7. Personal Information Protection Officer",
    "s7p1": "The personal information protection officer for this service is as follows.",
    "s7p2": "Email: gachamap1120@gmail.com",
    "s8Title": "8. Changes to This Privacy Policy",
    "s8p1": "This privacy policy may be amended in accordance with changes in laws, policies, or service content. Any changes will be announced via in-service notices.",
