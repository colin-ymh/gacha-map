  "terms": {
    "title": "服务条款",
    "back": "返回",
    "s1Title": "第1条（目的）",
    "s1p1": "本服务条款旨在规定扭蛋地图（以下简称\"服务\"）所提供服务的使用条件和程序，以及用户与服务之间的权利、义务和责任事项。",
    "s2Title": "第2条（术语定义）",
    "s2p1": "「用户」是指通过访问服务，依据本条款接受服务所提供内容的会员和非会员。",
    "s2p2": "「会员」是指向服务提供个人信息并完成会员注册的人，可持续获取服务信息并继续使用服务。",
    "s3Title": "第3条（服务条款的效力及变更）",
    "s3p1": "本服务条款对所有希望使用本服务的用户均具有效力。",
    "s3p2": "服务如有必要，可在不违反相关法律法规的范围内变更本条款，变更内容将通过服务内公告通知用户。",
    "s4Title": "第4条（服务的提供及变更）",
    "s4p1": "服务提供扭蛋店位置信息、店铺信息反馈受理、收藏夹管理等服务。",
    "s4p2": "服务在有充分理由时，可变更所提供服务的全部或部分内容。",
    "s5Title": "第5条（用户义务）",
    "s5p1": "用户不得进行以下行为。",
    "s5p2": "登记虚假信息、盗用他人信息、妨碍服务运营、侵犯版权等他人权利，以及其他违法或不当行为。",
    "s6Title": "第6条（服务使用限制）",
    "s6p1": "若用户违反本条款规定的义务或妨碍服务的正常运营，服务可限制该用户的使用权限。",
    "s7Title": "第7条（免责条款）",
    "s7p1": "因自然灾害、战争或与之相当的不可抗力导致无法提供服务时，服务免除相关服务提供责任。",
    "s7p2": "服务内的反馈信息基于用户提供的内容，服务不保证相关信息的准确性。",
    "s8Title": "第8条（联系方式）",
    "s8p1": "如有与服务使用相关的问题，请联系运营邮箱（gachamap1120@gmail.com）。",
    "effectiveDate": "生效日期: 2026年4月17日"
  },
  "privacy": {
    "title": "隐私政策",
    "back": "返回",
    "s1Title": "1. 收集的个人信息项目",
    "s1p1": "本服务在会员注册及使用过程中收集以下个人信息。",
    "s1p2": "通过社交登录（Google、Kakao、Naver）时：姓名、电子邮件地址、头像（可选）。",
    "s2Title": "2. 个人信息的收集及使用目的",
    "s2p1": "本服务将收集的个人信息用于以下目的。",
    "s2p2": "会员识别及服务提供、收藏夹和反馈记录管理、用于改善服务的统计分析。",
    "s3Title": "3. 个人信息的保存及使用期限",
    "s3p1": "会员注销或收集·使用目的达成后，将立即删除相关个人信息。",
    "s3p2": "但若根据相关法律法规有必要保存的，将在该期间内保管。",
    "s4Title": "4. 个人信息的第三方提供",
    "s4p1": "本服务原则上不向外部提供用户的个人信息。但依据法律规定或应执法机构要求的情况除外。",
    "s5Title": "5. 个人信息处理委托",
    "s5p1": "为顺利运营服务，本服务将个人信息处理委托给Supabase（数据库及认证服务）。委托业务内容及受托方将在隐私政策变更时予以公告。",
    "s6Title": "6. 用户权利",
    "s6p1": "用户可随时查看、修改自己的个人信息，或通过注销账号申请删除个人信息。",
    "s7Title": "7. 个人信息保护负责人",
    "s7p1": "本服务的个人信息保护负责人如下。",
    "s7p2": "电子邮件: gachamap1120@gmail.com",
    "s8Title": "8. 隐私政策的变更",
